{
  "manifest_version": 3,
  "name": "BI Esfinge SC",
  "description": "Captura status de envio e ratificações do TCE-SC para o Radar e-Sfinge BI",
  "version": "0.1.0",
  "permissions": ["storage", "tabs", "scripting", "alarms", "identity", "sidePanel", "notifications"],
  "host_permissions": [
    "https://virtual.tce.sc.gov.br/*",
    "https://api.virtual.tce.sc.gov.br/*",
    "https://paineis.tce.sc.gov.br/*",
    "https://paineistransparencia.tce.sc.gov.br/*",
    "https://firestore.googleapis.com/*",
    "https://identitytoolkit.googleapis.com/*",
    "https://securetoken.googleapis.com/*"
  ],
  "action": {
    "default_title": "Radar e-Sfinge",
    "default_icon": "icon.png"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "oauth2": {
    "client_id": "105816276065-l4223v26i7j930kbks846n24vlj76rrl.apps.googleusercontent.com",
    "scopes": ["https://www.googleapis.com/auth/userinfo.email"]
  },
  "key": ""
}
