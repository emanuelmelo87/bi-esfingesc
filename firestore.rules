rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function emailDoUsuario() {
      return request.auth.token.email.lower();
    }

    function isActive() {
      let ref = /databases/$(database)/documents/usuarios/$(emailDoUsuario());
      return !exists(ref) || get(ref).data.ativo != false;
    }

    // Conta Google @betha.com.br com e-mail verificado. Exigir o provedor Google
    // e o e-mail verificado fecha a brecha de alguém ligar "e-mail/senha" no
    // Firebase Auth e qualquer pessoa criar uma conta fulano@betha.com.br sem
    // provar que é dona do endereço.
    function contaBetha() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && request.auth.token.email.matches('.*@betha[.]com[.]br$');
    }

    function isBethaUser() {
      return contaBetha() && isActive();
    }

    function isAdmin() {
      let ref = /databases/$(database)/documents/usuarios/$(emailDoUsuario());
      return exists(ref)
        && get(ref).data.perfil == 'ADMIN_GERAL'
        && get(ref).data.ativo == true;
    }

    match /municipios/{id} {
      allow read: if isBethaUser();
      allow write: if isBethaUser() && isAdmin();
    }

    match /status_operacional_atual/{id} {
      allow read, write: if isBethaUser();
    }

    match /snapshots_diarios/{id} {
      allow read, write: if isBethaUser();
    }

    match /status_por_competencia/{id} {
      allow read, write: if isBethaUser();
    }

    match /atribuicoes_municipios/{id} {
      allow read: if isBethaUser();
      allow write: if isBethaUser() && isAdmin();
    }

    match /cargas/{id} {
      allow read, write: if isBethaUser();
    }

    match /movimentacoes/{id} {
      allow read, write: if isBethaUser();
    }

    match /usuarios/{email} {
      allow read: if contaBetha()
        && (emailDoUsuario() == email || isAdmin());

      allow create: if contaBetha()
        && emailDoUsuario() == email
        && request.resource.data.email == email
        && request.resource.data.perfil == 'LEITURA'
        && request.resource.data.ativo == true;

      allow update: if contaBetha()
        && (
          (emailDoUsuario() == email
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ultimo_login']))
          || isAdmin()
        );

      allow delete: if false;
    }
  }
}
